{
  "name": "xarch",
  "version": "1.0.0",
  "description": "XArch: A high-performance, multi-purpose WhatsApp bot built with Baileys and TypeScript.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "gyp:build": "node-gyp build",
    "gyp:rebuild": "node-gyp rebuild",
    "gyp:clean": "node-gyp clean",
    "prepare": "pnpm build",
    "postinstall": "pnpm gyp:build"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "typescript",
    "pnpm",
    "tsc",
    "node-gyp"
  ],
  "author": "Ananda Firmansyah",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc.3",
    "dotenv": "^17.2.3",
    "inquirer": "^12.10.0",
    "mongodb": "^6.20.0",
    "node-cache": "^5.1.2",
    "pino": "^10.0.0",
    "qrcode-terminal": "^0.12.0",
    "syntax-error": "^1.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/syntax-error": "^1.4.5",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^11.4.2",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
